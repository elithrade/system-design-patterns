{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Temporalio": "Warning"
    }
  },
  "ConnectionStrings": {
    "Videos": "Host=localhost;Port=56232;Database=videos;Username=postgres;Password=postgres;Maximum Pool Size=50"
  },
  "S3": {
    "ServiceUrl": "http://localhost:59100",
    "AccessKey": "minio",
    "SecretKey": "minio-secret"
  },
  "Storage": {
    "Bucket": "videos",
    "UploadUrlSeconds": 900,
    "MaxUploadMb": 2048
  },
  "Pipeline": {
    "Engine": "Inline",
    "Bus": "Local"
  },
  "Transcode": {
    "MsPerMb": 20,
    "Renditions": {
      "360p": 1.0,
      "720p": 2.0,
      "thumb": 0.1
    },
    "Workers": 4,
    "RunWorkers": true,
    "PollMilliseconds": 500,
    "LeaseSeconds": 30,
    "BackoffSeconds": 2,
    "MaxAttempts": 3
  },
  "Live": {
    "HeartbeatSeconds": 15
  },
  "Temporal": {
    "Address": "localhost:57333",
    "Namespace": "default",
    "TaskQueue": "publish",
    "UploadWaitSeconds": 3600,
    "HeartbeatTimeoutSeconds": 10
  },
  "Urls": "http://localhost:5900"
}
